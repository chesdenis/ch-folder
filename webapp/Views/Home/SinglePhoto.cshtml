@model webapp.Models.SinglePhotoViewModel
@{
    ViewData["Title"] = "Photo Details";
    var it = Model.Photo;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Photo Details</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-6 col-md-12">
            <div class="pswp-gallery" id="photo-gallery">
                <a href="@Url.Action("ByMd5", "Images", new { md5 = it.Md5, w = 2000 })"
                   data-pswp-width="@(it.Width ?? 2000)"
                   data-pswp-height="@(it.Height ?? 2000)"
                   target="_blank"
                   class="d-block mb-3">
                    <img src="@Url.Action("ByMd5", "Images", new { md5 = it.Md5, w = 512 })" alt="@it.Md5" class="img-fluid rounded shadow w-100" style="cursor: zoom-in;"/>
                </a>
                
                @if (Model.SimilarPhotos.Any())
                {
                    <div class="d-none">
                        @foreach (var s in Model.SimilarPhotos)
                        {
                            <a href="@Url.Action("ByMd5", "Images", new { md5 = s.Md5, w = 2000 })"
                               data-pswp-width="@(s.Width ?? 2000)"
                               data-pswp-height="@(s.Height ?? 2000)"
                               target="_blank">
                                <img src="@Url.Action("ByMd5", "Images", new { md5 = s.Md5, w = 256 })" alt="@s.Md5" />
                            </a>
                        }
                    </div>
                }
            </div>
            
            <div class="mt-2 text-center text-lg-start">
                <small class="text-muted">MD5: <code class="user-select-all">@it.Md5</code></small>
            </div>
        </div>
        <div class="col-lg-6 col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title h4 mb-3">Analysis & Details</h3>
                    <div class="fw-semibold text-break mb-3">@it.ShortDetails</div>
                    
                    @if (it.Tags is { Length: > 0 })
                    {
                        <div class="mb-3 d-flex align-items-start flex-wrap gap-2">
                            @foreach (var tag in it.Tags)
                            {
                                <span class="badge bg-secondary rounded-pill">@tag</span>
                            }
                        </div>
                    }

                    <div class="p-3 bg-light border rounded mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <strong class="me-2">Commerce Mark:</strong>
                            <span class="badge bg-primary fs-6">@it.CommerceMark</span>
                        </div>
                        <div class="text-muted">@it.ImprovementWays</div>
                    </div>

                    <div class="mb-4">
                        <h5 class="h6 text-muted border-bottom pb-2">Full Description</h5>
                        <div class="text-break" style="white-space: pre-wrap; max-height: 300px; overflow-y: auto;">@it.LargeDetails</div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(it.RealUrl))
                        {
                            <a href="@Url.Action("Download", "Images", new { md5 = it.Md5 })" class="btn btn-outline-primary" title="Download original image">
                                <i class="bi bi-download me-1"></i> Download
                            </a>
                        }
                        <button type="button" class="btn btn-outline-secondary copy-btn"
                                data-copy-text="@it.CommerceMark: @it.ImprovementWays" title="Copy commerce mark">
                            <i class="bi bi-clipboard-check me-1"></i> <span>Commerce Mark</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary copy-btn"
                                data-copy-text="@it.RefinementPrompt" title="Copy refinement prompt">
                            <i class="bi bi-clipboard-check me-1"></i> <span>Refinement Prompt</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary copy-btn"
                                data-copy-text="@it.ShortDetails" title="Copy short text">
                            <i class="bi bi-clipboard me-1"></i> <span>Short text</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary copy-btn"
                                data-copy-text="@it.LargeDetails" title="Copy full text">
                            <i class="bi bi-clipboard me-1"></i> <span>Full text</span>
                        </button>
                        @if (it.Tags is { Length: > 0 })
                        {
                            <button type="button" class="btn btn-outline-secondary copy-btn"
                                    data-copy-text="@string.Join(", ", it.Tags)" title="Copy tags">
                                <i class="bi bi-tags me-1"></i> <span>Copy tags</span>
                            </button>
                        }
                        <a href="@Url.Action("Search", "Home", new { query = it.ShortDetails })" class="btn btn-outline-success" title="Search similar images">
                            <i class="bi bi-search me-1"></i> Search similar
                        </a>
                    </div>
                    
                    <div class="mt-4 pt-3 border-top">
                        <h5 class="h6 text-muted mb-3">Publish Status</h5>
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                var platforms = new[] { "AdobeStock", "Alami", "ShutterStock" , "IStock", "Flickr" };
                            }
                            @foreach (var platform in platforms)
                            {
                                var isPublished = it.PublishPlatforms.Contains(platform, StringComparer.OrdinalIgnoreCase);
                                <button type="button" 
                                        class="btn btn-sm toggle-publish-btn @(isPublished ? "btn-success" : "btn-outline-secondary")"
                                        data-md5="@it.Md5" 
                                        data-platform="@platform">
                                    <i class="bi @(isPublished ? "bi-check-circle-fill" : "bi-circle") me-1"></i>
                                    @platform
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.SimilarPhotos.Any())
    {
        <div class="mt-5 mb-5">
            <h4 class="mb-4">Similar Photos in Group</h4>
            <div id="group-gallery">
                @await Component.InvokeAsync("Gallery", new { 
                    items = Model.SimilarPhotos.Select(s => new webapp.Components.GalleryItem {
                        FullUrl = Url.Action("ByMd5", "Images", new { md5 = s.Md5 })!,
                        FullWidth = s.Width ?? 2000,
                        FullHeight = s.Height ?? 2000,
                        Alt = s.Md5,
                        Md5 = s.Md5,
                        ShortDetails = s.ShortDetails
                    }).ToList(),
                    pageSize = 100,
                    thumbSize = 256
                })
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Handle clicking on similar photos to navigate to their SinglePhoto view
            const groupGallery = document.getElementById('group-gallery');
            if (groupGallery) {
                groupGallery.querySelectorAll('.gallery-item').forEach(item => {
                    item.addEventListener('click', (e) => {
                        // Prevent opening lightbox from the lower gallery
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const img = item.querySelector('img');
                        const md5 = img.getAttribute('data-md5');
                        if (md5) {
                            window.location.href = '@Url.Action("SinglePhoto", "Home")?md5=' + md5;
                        }
                    }, true); // Use capture phase to intercept before PhotoSwipe if it was attached there
                });
            }

            // Copy buttons logic
            async function copyToClipboard(text, btn) {
                let success = false;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    try {
                        await navigator.clipboard.writeText(text);
                        success = true;
                    } catch (err) {
                        console.error('Async: Could not copy text: ', err);
                    }
                }
                
                if (!success) {
                    // Fallback for non-secure contexts or failures
                    const textArea = document.createElement("textarea");
                    textArea.value = text;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-9999px";
                    textArea.style.top = "0";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        success = document.execCommand('copy');
                    } catch (err) {
                        console.error('Fallback: Unable to copy', err);
                    }
                    document.body.removeChild(textArea);
                }

                if (success) {
                    showSuccess(btn);
                }
            }

            function showSuccess(btn) {
                const icon = btn.querySelector('i');
                const label = btn.querySelector('span');
                const originalIconClass = icon.className;
                const originalLabel = label.textContent;
                
                icon.className = 'bi bi-check2 text-success me-1';
                label.textContent = 'Copied!';
                btn.classList.add('btn-outline-success');
                btn.classList.remove('btn-outline-secondary');
                
                setTimeout(() => {
                    icon.className = originalIconClass;
                    label.textContent = originalLabel;
                    btn.classList.remove('btn-outline-success');
                    btn.classList.add('btn-outline-secondary');
                }, 2000);
            }

            document.querySelectorAll('.copy-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const text = btn.getAttribute('data-copy-text');
                    copyToClipboard(text, btn);
                });
            });

            // Toggle publish status logic
            document.querySelectorAll('.toggle-publish-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const md5 = btn.getAttribute('data-md5');
                    const platform = btn.getAttribute('data-platform');
                    
                    btn.disabled = true;
                    try {
                        const response = await fetch('@Url.Action("TogglePublish", "Home")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: new URLSearchParams({
                                'md5': md5,
                                'platform': platform
                            })
                        });

                        if (response.ok) {
                            const isPublished = btn.classList.contains('btn-success');
                            if (isPublished) {
                                btn.classList.remove('btn-success');
                                btn.classList.add('btn-outline-secondary');
                                btn.querySelector('i').className = 'bi bi-circle me-1';
                            } else {
                                btn.classList.remove('btn-outline-secondary');
                                btn.classList.add('btn-success');
                                btn.querySelector('i').className = 'bi bi-check-circle-fill me-1';
                            }
                        } else {
                            alert('Failed to update publish status');
                        }
                    } catch (err) {
                        console.error('Error toggling publish status:', err);
                        alert('Error toggling publish status');
                    } finally {
                        btn.disabled = false;
                    }
                });
            });
        });
    </script>
    <script type="module">
        import PhotoSwipeLightbox from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe-lightbox.esm.js';
        const lightbox = new PhotoSwipeLightbox({
            gallery: '.pswp-gallery',
            children: 'a',
            pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js')
        });
        lightbox.init();
    </script>
}
