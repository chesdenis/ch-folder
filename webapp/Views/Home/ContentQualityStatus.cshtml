@using shared_csharp
@model webapp.Models.ValidationStatusViewModel
@{
    ViewData["Title"] = "Content Quality Status";
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <h1 class="mb-3">Content quality status</h1>

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-8">
                        <div class="form-control-plaintext">Storage: @ViewBag.StoragePath</div>
                    </div>
                    <div class="col-12 col-md-4 text-md-end">
                        <form asp-action="TruncateAnalysisResults" method="post" class="d-inline" 
                              onsubmit="return confirm('Are you sure you want to truncate all analysis results? This action cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger">Truncate Results</button>
                        </form>
                        <a class="btn btn-outline-secondary" href="@Url.Action("ContentQualityStatus")">Refresh</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Folder health and data consistency</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th scope="col" style="width:40%">Folder</th>
                            <th scope="col">Status Indicators</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var folderName in Model.Items.Select(s => s.Folder).Distinct().OrderBy(x => x).ToList())
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("ContentQualityDetails", new { folder = folderName })"
                                       title="View details">
                                        <code>@folderName</code>
                                    </a>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var fs in ModelConstants.ContentValidationKeys)
                                        {
                                            var test = Model.Items.FirstOrDefault(f => f.Folder.Equals(folderName) && f.TestKind.Equals(fs.Item1));
                                            var color = "#6c757d"; // Default Grey
                                            var status = "Missing";
                                            var failures = "";

                                            if (test != null)
                                            {
                                                status = test.Status;
                                                color = status switch
                                                {
                                                    "Passed" => "#28a745",
                                                    "Failed" => "#dc3545",
                                                    "Running" => "#ffc107",
                                                    _ => "#6c757d"
                                                };

                                                if (status == "Failed" && test.TotalFailures.HasValue)
                                                {
                                                    failures = test.TotalFailures.Value.ToString();
                                                }
                                            }

                                            <a href="@Url.Action("ContentQualityDetails", new { folder = folderName })"
                                               class="d-inline-flex align-items-center justify-content-center text-decoration-none text-white rounded"
                                               style="background-color: @color; min-width: 24px; height: 24px; font-size: 0.75rem; padding: 2px;"
                                               title="@fs.Item2: @status">
                                                @failures
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
