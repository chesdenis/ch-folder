@{
    ViewData["Title"] = "Navigation - Ch Photo Gallery";
    var queryText = Context.Request.Query["query"].ToString();
    var selectedTags = Context.Request.Query["tags"].ToArray();
    var selectedPersons = Context.Request.Query["persons"].ToArray();
    var filters = Context.Request.Query["filters"].ToArray();
    var sorting = Context.Request.Query["sorting"].ToArray();
    // Ordering by score (default) or commerce
    var qsOrderBy = Context.Request.Query["orderBy"].ToString();
    var vbOrderBy = ViewBag.OrderBy != null ? ViewBag.OrderBy.ToString() : string.Empty;
    var orderBy = string.IsNullOrWhiteSpace(qsOrderBy) ? vbOrderBy : qsOrderBy;
    orderBy = string.Equals(orderBy, "commerce", StringComparison.OrdinalIgnoreCase) ? "commerce" : "score";

    // Paging and view options from query
    var currentPage = int.TryParse(Context.Request.Query["page"], out var p) ? p : 1;
    var pageSize = int.TryParse(Context.Request.Query["pageSize"], out var ps) ? ps : 12;
    var thumbSize = int.TryParse(Context.Request.Query["size"], out var sz) ? sz : 256;
    // Score limiter (minScore) from query or ViewBag with default 0.78
    double minScore;
    var qsMinScore = Context.Request.Query["minScore"].ToString();
    if (!string.IsNullOrWhiteSpace(qsMinScore) && double.TryParse(qsMinScore, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var ms1))
    {
        minScore = ms1;
    }
    else
    {
        string vbMinScoreStr = ViewBag.MinScore != null ? (Convert.ToString(ViewBag.MinScore, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty) : string.Empty;
        double vbParsed;
        if (!string.IsNullOrWhiteSpace(vbMinScoreStr) && double.TryParse(vbMinScoreStr, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out vbParsed))
            minScore = vbParsed;
        else
            minScore = 0.78;
    }
    minScore = Math.Max(0, Math.Min(1, Math.Round(minScore, 2)));
    // Prefer real totals/items from controller if provided (handle possible string/object types safely)
    var vbPageStr = ViewBag.Page?.ToString();
    int vbPageParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbPageStr) && int.TryParse(vbPageStr, out vbPageParsed)) { currentPage = vbPageParsed; }

    var vbPsStr = ViewBag.PageSize?.ToString();
    int vbPsParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbPsStr) && int.TryParse(vbPsStr, out vbPsParsed)) { pageSize = vbPsParsed; }

    var vbSzStr = ViewBag.Size?.ToString();
    int vbSzParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbSzStr) && int.TryParse(vbSzStr, out vbSzParsed)) { thumbSize = vbSzParsed; }

    int totalItems;
    var vbTotalStr = ViewBag.Total?.ToString();
    int vbTotalParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbTotalStr) && int.TryParse(vbTotalStr, out vbTotalParsed))
    {
        totalItems = vbTotalParsed;
    }
    else if (!int.TryParse(Context.Request.Query["total"], out totalItems))
    {
        totalItems = 0;
    }

    var totalPages = (int)Math.Ceiling(totalItems / (double)Math.Max(1, pageSize));

    // Commerce rating filter (commerceRatings) from query or ViewBag with default [4, 5]
    int[] commerceRatings;
    var qsCommerceRatings = Context.Request.Query["commerceRatings"].ToArray();
    if (qsCommerceRatings.Length > 0)
    {
        commerceRatings = qsCommerceRatings.Select(s => int.TryParse(s, out var v) ? (int?)v : null).Where(v => v.HasValue).Select(v => v!.Value).ToArray();
    }
    else
    {
        commerceRatings = ViewBag.CommerceRatings is int[] crs ? crs : [4, 5];
    }
}

<div class="container-fluid mt-4 px-3">
    <!-- Fluent-style top toolbar: page size, filters, size controls -->
    <div class="row g-3">
        <div class="col-12">
            <div class="fluent-toolbar">
                <div class="toolbar-group" role="group" aria-label="Images per page">
                    <span class="toolbar-label no-margin">Images/page</span>
                    <div class="segmented">
                        <button type="button" class="seg-btn page-size-btn @(pageSize==6?"active":"")" data-pagesize="6">6</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==12?"active":"")" data-pagesize="12">12</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==24?"active":"")" data-pagesize="24">24</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==48?"active":"")" data-pagesize="48">48</button>
                    </div>
                </div>

                <!-- Tags selector placed inline in the toolbar -->
                <div class="toolbar-group" role="group" aria-label="Tags selector">
                    <span class="toolbar-label">Tags</span>
                    @await Component.InvokeAsync("TagsSelector", new {
                        availableTags = ViewBag.AvailableTags as IEnumerable<string>,
                        selectedTags = ViewBag.SelectedTags as IEnumerable<string>
                    })
                </div>

                <!-- Persons selector placed inline in the toolbar -->
                <div class="toolbar-group" role="group" aria-label="Persons selector">
                    <span class="toolbar-label">Persons</span>
                    <div class="person-input-container">
                        <div id="selectedPersonsChips" class="selected-chips">
                            @{
                                var selectedPersonsList = (ViewBag.SelectedPersons as IEnumerable<string> ?? Array.Empty<string>()).ToList();
                                foreach (var person in selectedPersonsList)
                                {
                                    <span class="chip" data-person="@person">
                                        @person
                                        <button type="button" class="remove-person-chip remove-chip" aria-label="Remove @person">&times;</button>
                                    </span>
                                }
                            }
                        </div>
                        <input type="text" id="personInput" class="person-input" placeholder="Add person..." autocomplete="off">
                        <div id="availablePersonsChips" class="available-chips">
                            @{
                                var availablePersons = (ViewBag.AvailablePersons as IEnumerable<string> ?? Array.Empty<string>()).Take(5);
                                foreach (var person in availablePersons)
                                {
                                    <span class="available-chip" data-person="@person">@person</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Storage selector with text box and hints -->
                <div class="toolbar-group" role="group" aria-label="Storage selector">
                    <span class="toolbar-label">Storage</span>
                    <div class="folder-input-container">
                        <div id="selectedStorageChips" class="selected-chips">
                            @{
                                var selectedPartitions = (ViewBag.SelectedPartitions as IEnumerable<string> ?? Array.Empty<string>()).ToList();
                                var selectedSections = (ViewBag.SelectedSections as IEnumerable<string> ?? Array.Empty<string>()).ToList();
                                
                                foreach (var partition in selectedPartitions)
                                {
                                    <span class="chip" data-folder="@partition" data-level="partition">
                                        @partition
                                        <button type="button" class="remove-folder-chip remove-chip" aria-label="Remove @partition">&times;</button>
                                    </span>
                                }
                                foreach (var sec in selectedSections)
                                {
                                    <span class="chip" data-folder="@sec" data-level="section">
                                        @sec
                                        <button type="button" class="remove-folder-chip remove-chip" aria-label="Remove @sec">&times;</button>
                                    </span>
                                }
                            }
                        </div>
                        <div class="folder-inputs">
                            <div class="l1-wrapper">
                                <input type="text" id="partitionInput" class="folder-input-l1" placeholder="Partition..." autocomplete="off">
                                <button type="button" id="addPartitionBtn" class="btn-add-l1" title="Add all from this partition">+</button>
                            </div>
                            <input type="text" id="sectionInput" class="folder-input" placeholder="Add section..." autocomplete="off">
                        </div>
                        <div id="availableStorageChips" class="available-chips">
                            @{
                                var availablePartitions = (ViewBag.AvailablePartitions as IEnumerable<string> ?? Enumerable.Empty<string>()).Take(5);
                                foreach (var partition in availablePartitions)
                                {
                                    <span class="available-chip" data-folder="@partition" data-level="partition">@partition</span>
                                }
                                var availableSections = (ViewBag.AvailableSections as IEnumerable<string> ?? Array.Empty<string>()).Take(5);
                                foreach (var sec in availableSections)
                                {
                                    <span class="available-chip" data-folder="@sec" data-level="section">@sec</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Extensions selector with text box and hints -->
                <div class="toolbar-group" role="group" aria-label="Extensions selector">
                    <span class="toolbar-label">Ext</span>
                    <div class="extension-input-container">
                        <div id="selectedExtensionsChips" class="selected-chips">
                            @{
                                var selectedExtensionsList = (ViewBag.SelectedExtensions as IEnumerable<string> ?? Array.Empty<string>()).ToList();
                                foreach (var ext in selectedExtensionsList)
                                {
                                    <span class="chip" data-extension="@ext">
                                        @ext
                                        <button type="button" class="remove-extension-chip remove-chip" aria-label="Remove @ext">&times;</button>
                                    </span>
                                }
                            }
                        </div>
                        <input type="text" id="extensionInput" class="extension-input" placeholder="Add ext..." autocomplete="off">
                        <div id="availableExtensionsChips" class="available-chips">
                            @{
                                var availableExtensions = (ViewBag.AvailableExtensions as IEnumerable<string> ?? Array.Empty<string>()).Take(5);
                                foreach (var ext in availableExtensions)
                                {
                                    <span class="available-chip" data-extension="@ext">@ext</span>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Commerce rating selector -->
                <div class="toolbar-group" role="group" aria-label="Commerce rating">
                    <span class="toolbar-label no-margin">Commerce</span>
                    <div class="segmented">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" class="seg-btn commerce-rate-btn @(commerceRatings.Contains(i) ? "active" : "")" data-rating="@i">@i</button>
                        }
                    </div>
                </div>

                <div class="toolbar-spacer"></div>

                <div class="toolbar-group" role="group" aria-label="Actions">
                    <button type="button" id="jumpToSearchBtn" class="seg-btn active" title="Search for these photos in Search page">
                        <i class="bi bi-search me-1"></i> Jump to Search
                    </button>
                </div>

                <div class="toolbar-group" role="group" aria-label="Thumbnail size">
                    <span class="toolbar-label no-margin">Thumb size</span>
                    <div class="segmented">
                        <button type="button" id="sizeDownBtn" class="seg-btn" aria-label="Make smaller">Smaller</button>
                        <button type="button" id="sizeUpBtn" class="seg-btn" aria-label="Make larger">Larger</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            @{
                // Default page: use real data items provided by controller
                var defaultItems = ViewBag.GalleryItems as IReadOnlyList<webapp.Components.GalleryItem> ?? new List<webapp.Components.GalleryItem>();
                totalItems = ViewBag.Total != null ? (int)ViewBag.Total : defaultItems.Count;
                totalPages = (int)Math.Ceiling(totalItems / (double)Math.Max(1, pageSize));

                @await Component.InvokeAsync("Pagination", new { currentPage, totalPages })
                @await Component.InvokeAsync("Gallery", new { page = 1, pageSize = pageSize, thumbSize = thumbSize, items = defaultItems, totalItems = totalItems })
                @await Component.InvokeAsync("Pagination", new { currentPage, totalPages })
            }
        </div>
    </div>
</div>



