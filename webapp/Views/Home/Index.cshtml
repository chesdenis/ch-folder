@section Scripts {
    <script type="module">
        import PhotoSwipeLightbox
            from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe-lightbox.esm.js';

        // Helpers to manage query string
        function setQueryParam(url, key, value) {
            const u = new URL(url, window.location.origin);
            if (value === null || value === undefined || value === '') {
                u.searchParams.delete(key);
            } else {
                u.searchParams.set(key, value);
            }
            return u.toString();
        }

        function wirePageSizeButtons() {
            const buttons = document.querySelectorAll('.page-size-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const size = btn.getAttribute('data-pagesize');
                    const url = new URL(window.location.href);
                    url.searchParams.set('pageSize', size);
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        function wireOrderByButtons() {
            const buttons = document.querySelectorAll('.order-by-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = btn.getAttribute('data-order');
                    const url = new URL(window.location.href);
                    url.searchParams.set('orderBy', val);
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        // Two-button size control via URL param manipulation (no server action)
        function getCurrentSize() {
            const allowed = [@string.Join(", ", shared_csharp.Extensions.ImageProcessingExtensions.AllowedSizes)];
            const params = new URL(window.location.href).searchParams;
            const sizeParam = parseInt(params.get('size') || '@thumbSize', 10);
            if (allowed.includes(sizeParam)) return sizeParam;
            // snap to nearest if arbitrary
            return allowed.reduce((prev, curr) => Math.abs(curr - sizeParam) < Math.abs(prev - sizeParam) ? curr : prev, allowed[0]);
        }
        function adjustSize(direction) {
            const allowed = [@string.Join(", ", shared_csharp.Extensions.ImageProcessingExtensions.AllowedSizes)];
            const current = getCurrentSize();
            const idx = allowed.indexOf(current);
            let newIdx = idx;
            if (direction === 'up') newIdx = Math.min(allowed.length - 1, idx + 1);
            if (direction === 'down') newIdx = Math.max(0, idx - 1);
            const nextSize = allowed[newIdx];
            
            // Navigate via server to ensure correct action and state
            const url = new URL(window.location.origin + '/Home/' + (direction === 'up' ? 'SizeUp' : 'SizeDown'));
            url.search = window.location.search;
            url.searchParams.set('size', nextSize);
            window.location.href = url.toString();
        }
        function wireSizeButtons() {
            const up = document.getElementById('sizeUpBtn');
            const down = document.getElementById('sizeDownBtn');
            if (up) up.addEventListener('click', () => adjustSize('up'));
            if (down) down.addEventListener('click', () => adjustSize('down'));
        }

        // Score limiter buttons handling
        function getCurrentMinScore() {
            const params = new URL(window.location.href).searchParams;
            const qs = params.get('minScore');
            let v = parseFloat(qs ?? document.getElementById('minScoreInput')?.value ?? '0.78');
            if (isNaN(v)) v = 0.78;
            v = Math.max(0, Math.min(1, v));
            return Math.round(v * 100) / 100;
        }
        function adjustMinScore(delta) {
            const v = getCurrentMinScore();
            const url = new URL(window.location.origin + '/Home/' + (delta > 0 ? 'RankUp' : 'RankDown'));
            url.search = window.location.search;
            url.searchParams.set('minScore', v.toFixed(2));
            window.location.href = url.toString();
        }
        function wireRankButtons() {
            const up = document.getElementById('rankUpBtn');
            const down = document.getElementById('rankDownBtn');
            if (up) up.addEventListener('click', () => adjustMinScore(0.01));
            if (down) down.addEventListener('click', () => adjustMinScore(-0.01));
        }

        // Commerce rating buttons handling
        function wireCommerceButtons() {
            const buttons = document.querySelectorAll('.commerce-rate-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const rating = btn.getAttribute('data-rating');
                    const url = new URL(window.location.href);
                   
                    let ratings = url.searchParams.getAll('commerceRatings');
                    if (ratings.includes(rating)) {
                        ratings = ratings.filter(r => r !== rating);
                    } else {
                        ratings.push(rating);
                    }
                    url.searchParams.delete('commerceRatings');
                    ratings.forEach(r => url.searchParams.append('commerceRatings', r));
                    
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        function wireFilterButtons() {
            // Tags (updated for custom chips with fetch)
            const tagInput = document.getElementById('tagInput');
            if (tagInput) {
                tagInput.addEventListener('input', () => {
                    window.updateAvailableChips('tagInput', 'availableTagsChips', '/Home/Tags', 'tag');
                });

                tagInput.addEventListener('change', () => {
                    const tag = tagInput.value.trim();
                    if (!tag) return;
                    
                    const url = new URL(window.location.href);
                    let tags = url.searchParams.getAll('tags');
                    if (!tags.includes(tag)) {
                        tags.push(tag);
                        url.searchParams.delete('tags');
                        tags.forEach(t => url.searchParams.append('tags', t));
                        url.searchParams.set('page', '1');
                        window.location.href = url.toString();
                    }
                    tagInput.value = '';
                });
                tagInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') tagInput.dispatchEvent(new Event('change'));
                });

                // Initial chips limit to 5
                const availableTags = document.querySelectorAll('#availableTagsChips .available-chip');
                availableTags.forEach((chip, idx) => {
                    if (idx >= 5) chip.remove();
                    else {
                        chip.addEventListener('click', () => {
                            tagInput.value = chip.getAttribute('data-tag');
                            tagInput.dispatchEvent(new Event('change'));
                        });
                    }
                });
            }

            document.querySelectorAll('.remove-tag-chip').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const chip = e.target.closest('.chip');
                    const tag = chip.getAttribute('data-tag');
                    const url = new URL(window.location.href);
                    let tags = url.searchParams.getAll('tags');
                    tags = tags.filter(t => t !== tag);
                    url.searchParams.delete('tags');
                    tags.forEach(t => url.searchParams.append('tags', t));
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                });
            });

            // Persons (updated for custom chips with fetch)
            const personInput = document.getElementById('personInput');
            if (personInput) {
                personInput.addEventListener('input', () => {
                    window.updateAvailableChips('personInput', 'availablePersonsChips', '/Home/Persons', 'person');
                });

                personInput.addEventListener('change', () => {
                    const person = personInput.value.trim();
                    if (!person) return;
                    
                    const url = new URL(window.location.href);
                    let persons = url.searchParams.getAll('persons');
                    if (!persons.includes(person)) {
                        persons.push(person);
                        url.searchParams.delete('persons');
                        persons.forEach(p => url.searchParams.append('persons', p));
                        url.searchParams.set('page', '1');
                        window.location.href = url.toString();
                    }
                    personInput.value = '';
                });
                personInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') personInput.dispatchEvent(new Event('change'));
                });

                // Initial chips limit to 5
                const availablePersons = document.querySelectorAll('#availablePersonsChips .available-chip');
                availablePersons.forEach((chip, idx) => {
                    if (idx >= 5) chip.remove();
                    else {
                        chip.addEventListener('click', () => {
                            personInput.value = chip.getAttribute('data-person');
                            personInput.dispatchEvent(new Event('change'));
                        });
                    }
                });
            }

            document.querySelectorAll('.remove-person-chip').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const chip = e.target.closest('.chip');
                    const person = chip.getAttribute('data-person');
                    const url = new URL(window.location.href);
                    let persons = url.searchParams.getAll('persons');
                    persons = persons.filter(p => p !== person);
                    url.searchParams.delete('persons');
                    persons.forEach(p => url.searchParams.append('persons', p));
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                });
            });

            // Storage (updated for custom chips with fetch)
            const sectionInput = document.getElementById('sectionInput');
            const partitionInput = document.getElementById('partitionInput');

            if (partitionInput) {
                partitionInput.addEventListener('input', () => {
                    window.updateAvailableChips('partitionInput', 'availableStorageChips', '/Home/Partitions', 'folder', 'partition');
                });
                
                partitionInput.addEventListener('change', () => {
                    const val = partitionInput.value.trim();
                    if (!val) return;
                    const url = new URL(window.location.href);
                    let partitions = url.searchParams.getAll('partitions');
                    if (!partitions.includes(val)) {
                        url.searchParams.append('partitions', val);
                        url.searchParams.set('page', '1');
                        window.location.href = url.toString();
                    }
                    partitionInput.value = '';
                });
                partitionInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') partitionInput.dispatchEvent(new Event('change'));
                });

                document.getElementById('addPartitionBtn')?.addEventListener('click', () => {
                    partitionInput.dispatchEvent(new Event('change'));
                });
            }

            if (sectionInput) {
                sectionInput.addEventListener('input', () => {
                    window.updateAvailableChips('sectionInput', 'availableStorageChips', '/Home/Sections', 'folder', 'section');
                });
                
                sectionInput.addEventListener('change', () => {
                    const val = sectionInput.value.trim();
                    if (!val) return;
                    const url = new URL(window.location.href);
                    let sections = url.searchParams.getAll('sections');
                    if (!sections.includes(val)) {
                        sections.push(val);
                        url.searchParams.delete('sections');
                        sections.forEach(s => url.searchParams.append('sections', s));
                        url.searchParams.set('page', '1');
                        window.location.href = url.toString();
                    }
                    sectionInput.value = '';
                });
                sectionInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') sectionInput.dispatchEvent(new Event('change'));
                });
            }

            // Initial chips limit to 5
            const availableStorage = document.querySelectorAll('#availableStorageChips .available-chip');
            availableStorage.forEach((chip, idx) => {
                if (idx >= 5) chip.remove();
                else {
                    chip.addEventListener('click', () => {
                        if (chip.getAttribute('data-level') === 'partition') {
                            partitionInput.value = chip.getAttribute('data-folder');
                            partitionInput.dispatchEvent(new Event('change'));
                        } else {
                            sectionInput.value = chip.getAttribute('data-folder');
                            sectionInput.dispatchEvent(new Event('change'));
                        }
                    });
                }
            });

            document.querySelectorAll('.remove-folder-chip').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const chip = e.target.closest('.chip');
                    const folder = chip.getAttribute('data-folder');
                    const level = chip.getAttribute('data-level');
                    const paramName = level === 'partition' ? 'partitions' : 'sections';
                    
                    const url = new URL(window.location.href);
                    let items = url.searchParams.getAll(paramName);
                    items = items.filter(f => f !== folder);
                    url.searchParams.delete(paramName);
                    items.forEach(f => url.searchParams.append(paramName, f));
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                });
            });

            // Extensions (updated for custom chips with fetch)
            const extensionInput = document.getElementById('extensionInput');
            if (extensionInput) {
                extensionInput.addEventListener('input', () => {
                    window.updateAvailableChips('extensionInput', 'availableExtensionsChips', '/Home/Extensions', 'extension');
                });

                extensionInput.addEventListener('change', () => {
                    const ext = extensionInput.value.trim();
                    if (!ext) return;
                    
                    const url = new URL(window.location.href);
                    let extensions = url.searchParams.getAll('extensions');
                    if (!extensions.includes(ext)) {
                        extensions.push(ext);
                        url.searchParams.delete('extensions');
                        extensions.forEach(e => url.searchParams.append('extensions', e));
                        url.searchParams.set('page', '1');
                        window.location.href = url.toString();
                    }
                    extensionInput.value = '';
                });

                extensionInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        extensionInput.dispatchEvent(new Event('change'));
                    }
                });

                // Initial chips limit to 5
                const availableExtensions = document.querySelectorAll('#availableExtensionsChips .available-chip');
                availableExtensions.forEach((chip, idx) => {
                    if (idx >= 5) chip.remove();
                    else {
                        chip.addEventListener('click', () => {
                            extensionInput.value = chip.getAttribute('data-extension');
                            extensionInput.dispatchEvent(new Event('change'));
                        });
                    }
                });
            }

            document.querySelectorAll('.remove-extension-chip').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const chip = e.target.closest('.chip');
                    const ext = chip.getAttribute('data-extension');
                    const url = new URL(window.location.href);
                    let extensions = url.searchParams.getAll('extensions');
                    extensions = extensions.filter(e => e !== ext);
                    url.searchParams.delete('extensions');
                    extensions.forEach(e => url.searchParams.append('extensions', e));
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                });
            });
        }

        function wireJumpToSearch() {
            const btn = document.getElementById('jumpToSearchBtn');
            if (!btn) return;
            btn.addEventListener('click', () => {
                // Collect ShortDetails from gallery items
                const details = Array.from(document.querySelectorAll('.gallery-item'))
                    .map(el => el.getAttribute('data-short-details'))
                    .filter(d => d && d.length > 0);
                
                if (details.length === 0) {
                    alert('No photo details found to search for.');
                    return;
                }

                // Deduplicate and join into a single sentence
                const allSentences = details.flatMap(d => d.split('.').map(s => s.trim()).filter(s => s.length > 0));
                const uniqueSentences = [...new Set(allSentences)];
                const query = uniqueSentences.join('. ').trim();
                
                const url = new URL(window.location.origin + '/Home/Search');
                url.searchParams.set('query', query);
                
                // Carry over commerce rating if it was set
                const params = new URL(window.location.href).searchParams;
                const crs = params.getAll('commerceRatings');
                crs.forEach(cr => {
                    url.searchParams.append('commerceRatings', cr);
                });
                
                // Carry over storage filters
                params.getAll('partitions').forEach(f => url.searchParams.append('partitions', f));
                params.getAll('sections').forEach(f => url.searchParams.append('sections', f));
                
                window.location.href = url.toString();
            });
        }

        document.addEventListener('DOMContentLoaded', () => { 
            wirePageSizeButtons(); 
            wireSizeButtons(); 
            wireCommerceButtons();
            wireFilterButtons();
            wireJumpToSearch();
            preloadSelected();
            wireSelectionHandlers();
        });

        // Server now provides real slide sizes via data-pswp-width/height

        const lightbox = new PhotoSwipeLightbox({
            gallery: '#my-gallery',
            children: 'a',
            pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js')
        });

        lightbox.init();

        // --- Selection handlers (click/touch) ---
        const sessionId = '@(ViewBag.SessionId != null ? ViewBag.SessionId.ToString() : string.Empty)';
        function isValidGuid(g) { return /^[0-9a-fA-F-]{36}$/.test(g); }
        function markSelected(el, selected) {
            if (selected) el.classList.add('selected-thumb'); else el.classList.remove('selected-thumb');
        }
        function handleSelectClick(ev) {
            // Only enable selection on search results pages where sessionId is known
            if (!isValidGuid(sessionId)) return;
            const img = ev.currentTarget;
            const md5 = img.getAttribute('data-md5');
            if (!md5) return;
            ev.preventDefault();
            ev.stopPropagation();

            const selected = !img.classList.contains('selected-thumb');
            const url = selected ? '/selection/add' : '/selection/remove';
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: sessionId, md5: md5 })
            }).then(r => {
                if (r.ok) {
                    markSelected(img, selected);
                }
            }).catch(() => {});
        }

        async function preloadSelected() {
            if (!isValidGuid(sessionId)) return;
            try {
                const r = await fetch(`/selection/list?sessionId=${sessionId}`);
                if (!r.ok) return;
                const md5s = await r.json();
                if (!Array.isArray(md5s)) return;
                const set = new Set(md5s);
                document.querySelectorAll('#my-gallery img[data-md5]')
                    .forEach(img => {
                        const md5 = img.getAttribute('data-md5');
                        if (md5 && set.has(md5)) markSelected(img, true);
                    });
            } catch {}
        }

        function wireSelectionHandlers() {
            if (!isValidGuid(sessionId)) return;
            document.querySelectorAll('#my-gallery img[data-md5]')
                .forEach(img => {
                    img.style.cursor = 'pointer';
                    img.addEventListener('click', handleSelectClick, { passive: false });
                    img.addEventListener('touchend', handleSelectClick, { passive: false });
                });
        }
    </script>
}

