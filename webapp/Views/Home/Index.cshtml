@{
    ViewData["Title"] = "Navigation - Ch Photo Gallery";
    var queryText = Context.Request.Query["query"].ToString();
    var selectedTags = Context.Request.Query["tags"].ToArray();
    var selectedPersons = Context.Request.Query["persons"].ToArray();
    var filters = Context.Request.Query["filters"].ToArray();
    var sorting = Context.Request.Query["sorting"].ToArray();
    // Ordering by score (default) or commerce
    var qsOrderBy = Context.Request.Query["orderBy"].ToString();
    var vbOrderBy = ViewBag.OrderBy != null ? ViewBag.OrderBy.ToString() : string.Empty;
    var orderBy = string.IsNullOrWhiteSpace(qsOrderBy) ? vbOrderBy : qsOrderBy;
    orderBy = string.Equals(orderBy, "commerce", StringComparison.OrdinalIgnoreCase) ? "commerce" : "score";

    // Paging and view options from query
    var currentPage = int.TryParse(Context.Request.Query["page"], out var p) ? p : 1;
    var pageSize = int.TryParse(Context.Request.Query["pageSize"], out var ps) ? ps : 12;
    var thumbSize = int.TryParse(Context.Request.Query["size"], out var sz) ? sz : 256;
    // Score limiter (minScore) from query or ViewBag with default 0.78
    double minScore;
    var qsMinScore = Context.Request.Query["minScore"].ToString();
    if (!string.IsNullOrWhiteSpace(qsMinScore) && double.TryParse(qsMinScore, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var ms1))
    {
        minScore = ms1;
    }
    else
    {
        string vbMinScoreStr = ViewBag.MinScore != null ? (Convert.ToString(ViewBag.MinScore, System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty) : string.Empty;
        double vbParsed;
        if (!string.IsNullOrWhiteSpace(vbMinScoreStr) && double.TryParse(vbMinScoreStr, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out vbParsed))
            minScore = vbParsed;
        else
            minScore = 0.78;
    }
    minScore = Math.Max(0, Math.Min(1, Math.Round(minScore, 2)));
    // Prefer real totals/items from controller if provided (handle possible string/object types safely)
    var vbPageStr = ViewBag.Page?.ToString();
    int vbPageParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbPageStr) && int.TryParse(vbPageStr, out vbPageParsed)) { currentPage = vbPageParsed; }

    var vbPsStr = ViewBag.PageSize?.ToString();
    int vbPsParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbPsStr) && int.TryParse(vbPsStr, out vbPsParsed)) { pageSize = vbPsParsed; }

    var vbSzStr = ViewBag.Size?.ToString();
    int vbSzParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbSzStr) && int.TryParse(vbSzStr, out vbSzParsed)) { thumbSize = vbSzParsed; }

    int totalItems;
    var vbTotalStr = ViewBag.Total?.ToString();
    int vbTotalParsed = 0;
    if (!string.IsNullOrWhiteSpace(vbTotalStr) && int.TryParse(vbTotalStr, out vbTotalParsed))
    {
        totalItems = vbTotalParsed;
    }
    else if (!int.TryParse(Context.Request.Query["total"], out totalItems))
    {
        totalItems = 0;
    }

    var totalPages = (int)Math.Ceiling(totalItems / (double)Math.Max(1, pageSize));

    // Commerce rating filter (commerceRatings) from query or ViewBag with default [4, 5]
    int[] commerceRatings;
    var qsCommerceRatings = Context.Request.Query["commerceRatings"].ToArray();
    if (qsCommerceRatings.Length > 0)
    {
        commerceRatings = qsCommerceRatings.Select(s => int.TryParse(s, out var v) ? (int?)v : null).Where(v => v.HasValue).Select(v => v!.Value).ToArray();
    }
    else
    {
        commerceRatings = ViewBag.CommerceRatings is int[] crs ? crs : [4, 5];
    }
}

<div class="container-fluid mt-4 px-3">
    <!-- Fluent-style top toolbar: page size, filters, size controls -->
    <div class="row g-3">
        <div class="col-12">
            <div class="fluent-toolbar">
                <div class="toolbar-group" role="group" aria-label="Images per page">
                    <span class="toolbar-label no-margin">Images/page</span>
                    <div class="segmented">
                        <button type="button" class="seg-btn page-size-btn @(pageSize==6?"active":"")" data-pagesize="6">6</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==12?"active":"")" data-pagesize="12">12</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==24?"active":"")" data-pagesize="24">24</button>
                        <button type="button" class="seg-btn page-size-btn @(pageSize==48?"active":"")" data-pagesize="48">48</button>
                    </div>
                </div>

                <!-- Tags selector placed inline in the toolbar -->
                <div class="toolbar-group" role="group" aria-label="Tags selector">
                    <span class="toolbar-label">Tags</span>
                    @await Component.InvokeAsync("MultiSelector", new {
                        id = "tagsSelector",
                        parameterName = "tags",
                        availableValues = ViewBag.AvailableTags as IEnumerable<string>,
                        selectedValues = ViewBag.SelectedTags as IEnumerable<string>,
                        placeholder = "Add tag..."
                    })
                </div>

                <!-- Persons selector placed inline in the toolbar -->
                <div class="toolbar-group" role="group" aria-label="Persons selector">
                    <span class="toolbar-label">Persons</span>
                    @await Component.InvokeAsync("MultiSelector", new {
                        id = "personsSelector",
                        parameterName = "persons",
                        availableValues = ViewBag.AvailablePersons as IEnumerable<string>,
                        selectedValues = ViewBag.SelectedPersons as IEnumerable<string>,
                        placeholder = "Add person..."
                    })
                </div>

                <!-- Folders selector with text box and hints -->
                <div class="toolbar-group" role="group" aria-label="Folders selector">
                    <span class="toolbar-label">Folders</span>
                    <div class="folder-input-container-v2">
                        @await Component.InvokeAsync("MultiSelector", new {
                            id = "foldersL1Selector",
                            parameterName = "foldersL1",
                            availableValues = ViewBag.AvailableFoldersLevel1 as IEnumerable<string>,
                            selectedValues = ViewBag.SelectedFoldersL1 as IEnumerable<string>,
                            placeholder = "Add partition..."
                        })
                        @await Component.InvokeAsync("MultiSelector", new {
                            id = "foldersL2Selector",
                            parameterName = "foldersL2",
                            availableValues = ViewBag.AvailableFoldersLevel2 as IEnumerable<string>,
                            selectedValues = ViewBag.SelectedFoldersL2 as IEnumerable<string>,
                            placeholder = "Add event..."
                        })
                    </div>
                </div>

                <!-- Extensions selector with text box and hints -->
                <div class="toolbar-group" role="group" aria-label="Extensions selector">
                    <span class="toolbar-label">Ext</span>
                    @await Component.InvokeAsync("MultiSelector", new {
                        id = "extensionsSelector",
                        parameterName = "extensions",
                        availableValues = ViewBag.AvailableExtensions as IEnumerable<string>,
                        selectedValues = ViewBag.SelectedExtensions as IEnumerable<string>,
                        placeholder = "Add ext..."
                    })
                </div>

                <!-- Commerce rating selector -->
                <div class="toolbar-group" role="group" aria-label="Commerce rating">
                    <span class="toolbar-label no-margin">Commerce</span>
                    <div class="segmented">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" class="seg-btn commerce-rate-btn @(commerceRatings.Contains(i) ? "active" : "")" data-rating="@i">@i</button>
                        }
                    </div>
                </div>

                <div class="toolbar-spacer"></div>

                <div class="toolbar-group" role="group" aria-label="Actions">
                    <button type="button" id="jumpToSearchBtn" class="seg-btn active" title="Search for these photos in Search page">
                        <i class="bi bi-search me-1"></i> Jump to Search
                    </button>
                </div>

                <div class="toolbar-group" role="group" aria-label="Thumbnail size">
                    <span class="toolbar-label no-margin">Thumb size</span>
                    <div class="segmented">
                        <button type="button" id="sizeDownBtn" class="seg-btn" aria-label="Make smaller">Smaller</button>
                        <button type="button" id="sizeUpBtn" class="seg-btn" aria-label="Make larger">Larger</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-12">
            @{
                // Default page: use real data items provided by controller
                var defaultItems = ViewBag.GalleryItems as IReadOnlyList<webapp.Components.GalleryItem> ?? new List<webapp.Components.GalleryItem>();
                totalItems = ViewBag.Total != null ? (int)ViewBag.Total : defaultItems.Count;
                totalPages = (int)Math.Ceiling(totalItems / (double)Math.Max(1, pageSize));

                @await Component.InvokeAsync("Pagination", new { currentPage, totalPages })
                @await Component.InvokeAsync("Gallery", new { page = 1, pageSize = pageSize, thumbSize = thumbSize, items = defaultItems, totalItems = totalItems })
                @await Component.InvokeAsync("Pagination", new { currentPage, totalPages })
            }
        </div>
    </div>
</div>



@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.css">
    <style>
        .folder-input-container-v2 {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-width: 400px;
        }
        .fluent-toolbar {
            display: flex;
            align-items: center;
            gap: .75rem;
            flex-wrap: wrap;
            background: var(--bs-body-bg);
            border: 1px solid rgba(0,0,0,.08);
            border-radius: 12px;
            padding: .75rem;
            box-shadow: 0 1px 2px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
        }
        .toolbar-group { display: flex; align-items: flex-start; gap: .5rem; }
        .toolbar-label { font-size: .95rem; color: #6c757d; margin-top: 0.5rem; }
        .toolbar-label.no-margin { margin-top: 0; align-self: center; }
        .segmented { display: inline-flex; border: 1px solid rgba(0,0,0,.1); border-radius: 10px; overflow: hidden; }
        .seg-btn {
            background: transparent;
            border: 0;
            padding: .6rem .9rem;
            min-width: 3.25rem;
            font-size: 1rem;
            touch-action: manipulation;
        }
        .seg-btn:focus { outline: none; }
        .segmented .seg-btn + .seg-btn { border-left: 1px solid rgba(0,0,0,.1); }
        .seg-btn:hover { background: rgba(0,0,0,.04); }
        .seg-btn.active { background: rgba(0, 90, 255, .12); color: rgb(0, 82, 204); font-weight: 600; }
        .toolbar-spacer { flex: 1; }
        .btn.touch, .seg-btn { border-radius: 10px; }

        /* Folders selector styling */
        .tag-input-container, .person-input-container, .extension-input-container {
            display: none;
        }
        .selected-chips {
            display: flex;
            gap: 0.25rem;
            flex-wrap: wrap;
        }
        .chip {
            display: inline-flex;
            align-items: center;
            background: rgba(0, 90, 255, .12);
            color: rgb(0, 82, 204);
            border: 1px solid rgba(0, 90, 255, .3);
            border-radius: 6px;
            padding: 0.1rem 0.4rem;
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
        }
        .remove-chip {
            background: transparent;
            border: none;
            color: rgb(0, 82, 204);
            margin-left: 0.25rem;
            padding: 0;
            cursor: pointer;
            font-size: 1.1rem;
            line-height: 1;
        }
        .folder-input, .tag-input, .person-input, .extension-input {
            border: 1px solid rgba(0,0,0,.1);
            border-radius: 6px;
            background: #fff;
            outline: none;
            font-size: 0.95rem;
            padding: 0.25rem 0.5rem;
            width: 100%;
        }

        /* Tags selector chips styling to match fluent toolbar */
        .tags-selector { display: inline-flex; flex-wrap: wrap; gap: .5rem; }
        .tag-btn {
            display: inline-flex;
            align-items: center;
            padding: .5rem .75rem;
            border: 1px solid rgba(0,0,0,.1);
            border-radius: 9999px;
            background: transparent;
            font-size: .95rem;
            line-height: 1;
            cursor: pointer;
            user-select: none;
        }
        .tag-btn:hover { background: rgba(0,0,0,.04); }
        .tag-btn.active {
            background: rgba(0, 90, 255, .12);
            color: rgb(0, 82, 204);
            border-color: rgba(0, 90, 255, .3);
            font-weight: 600;
        }
        /* Selection highlight */
        #my-gallery img.selected-thumb {
            outline: 3px solid #0d6efd;
            outline-offset: 2px;
            box-shadow: 0 0 0 4px rgba(13,110,253,.2);
            border-radius: 6px;
        }
        #my-gallery img {
            object-fit: contain;
        }
        @@media (pointer: coarse) {
            .seg-btn { padding: .8rem 1.1rem; font-size: 1.05rem; }
            .btn.touch { padding: .9rem 1.25rem; font-size: 1.05rem; }
            .tags-selector .tag-btn { padding: .65rem .9rem; }
        }
    </style>
}

@section Scripts {
    <script type="module">
        import PhotoSwipeLightbox
            from 'https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe-lightbox.esm.js';

        // Helpers to manage query string
        function setQueryParam(url, key, value) {
            const u = new URL(url, window.location.origin);
            if (value === null || value === undefined || value === '') {
                u.searchParams.delete(key);
            } else {
                u.searchParams.set(key, value);
            }
            return u.toString();
        }
        function wirePageSizeButtons() {
            const buttons = document.querySelectorAll('.page-size-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const size = btn.getAttribute('data-pagesize');
                    const url = new URL(window.location.href);
                    url.searchParams.set('pageSize', size);
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        function wireOrderByButtons() {
            const buttons = document.querySelectorAll('.order-by-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = btn.getAttribute('data-order');
                    const url = new URL(window.location.href);
                    url.searchParams.set('orderBy', val);
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        // Two-button size control via URL param manipulation (no server action)
        function getCurrentSize() {
            const allowed = [@string.Join(", ", shared_csharp.Extensions.ImageProcessingExtensions.AllowedSizes)];
            const params = new URL(window.location.href).searchParams;
            const sizeParam = parseInt(params.get('size') || '@thumbSize', 10);
            if (allowed.includes(sizeParam)) return sizeParam;
            // snap to nearest if arbitrary
            return allowed.reduce((prev, curr) => Math.abs(curr - sizeParam) < Math.abs(prev - sizeParam) ? curr : prev, allowed[0]);
        }
        function adjustSize(direction) {
            const allowed = [@string.Join(", ", shared_csharp.Extensions.ImageProcessingExtensions.AllowedSizes)];
            const current = getCurrentSize();
            const idx = allowed.indexOf(current);
            let newIdx = idx;
            if (direction === 'up') newIdx = Math.min(allowed.length - 1, idx + 1);
            if (direction === 'down') newIdx = Math.max(0, idx - 1);
            const nextSize = allowed[newIdx];
            
            // Navigate via server to ensure correct action and state
            const url = new URL(window.location.origin + '/Home/' + (direction === 'up' ? 'SizeUp' : 'SizeDown'));
            url.search = window.location.search;
            url.searchParams.set('size', nextSize);
            window.location.href = url.toString();
        }
        function wireSizeButtons() {
            const up = document.getElementById('sizeUpBtn');
            const down = document.getElementById('sizeDownBtn');
            if (up) up.addEventListener('click', () => adjustSize('up'));
            if (down) down.addEventListener('click', () => adjustSize('down'));
        }

        // Score limiter buttons handling
        function getCurrentMinScore() {
            const params = new URL(window.location.href).searchParams;
            const qs = params.get('minScore');
            let v = parseFloat(qs ?? document.getElementById('minScoreInput')?.value ?? '0.78');
            if (isNaN(v)) v = 0.78;
            v = Math.max(0, Math.min(1, v));
            return Math.round(v * 100) / 100;
        }
        function adjustMinScore(delta) {
            const v = getCurrentMinScore();
            const url = new URL(window.location.origin + '/Home/' + (delta > 0 ? 'RankUp' : 'RankDown'));
            url.search = window.location.search;
            url.searchParams.set('minScore', v.toFixed(2));
            window.location.href = url.toString();
        }
        function wireRankButtons() {
            const up = document.getElementById('rankUpBtn');
            const down = document.getElementById('rankDownBtn');
            if (up) up.addEventListener('click', () => adjustMinScore(0.01));
            if (down) down.addEventListener('click', () => adjustMinScore(-0.01));
        }

        // Commerce rating buttons handling
        function wireCommerceButtons() {
            const buttons = document.querySelectorAll('.commerce-rate-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const rating = btn.getAttribute('data-rating');
                    const url = new URL(window.location.href);
                   
                    let ratings = url.searchParams.getAll('commerceRatings');
                    if (ratings.includes(rating)) {
                        ratings = ratings.filter(r => r !== rating);
                    } else {
                        ratings.push(rating);
                    }
                    url.searchParams.delete('commerceRatings');
                    ratings.forEach(r => url.searchParams.append('commerceRatings', r));
                    
                    url.searchParams.set('page', '1');
                    // Ensure it stays on Index page
                    url.pathname = '/Home/Index';
                    window.location.href = url.toString();
                });
            });
        }

        function wireFilterButtons() {
            const addValueToQuery = (paramName, value) => {
                const url = new URL(window.location.href);
                let values = url.searchParams.getAll(paramName);
                if (!values.includes(value)) {
                    url.searchParams.append(paramName, value);
                    url.searchParams.set('page', '1');
                    window.location.href = url.toString();
                }
            };

            const removeValueFromQuery = (paramName, value) => {
                const url = new URL(window.location.href);
                let values = url.searchParams.getAll(paramName);
                values = values.filter(v => v !== value);
                url.searchParams.delete(paramName);
                values.forEach(v => url.searchParams.append(paramName, v));
                url.searchParams.set('page', '1');
                window.location.href = url.toString();
            };

            document.querySelectorAll('.multi-selector-container').forEach(container => {
                const paramName = container.getAttribute('data-parameter');
                const allSuggestions = JSON.parse(container.getAttribute('data-all-suggestions') || '[]');
                const input = container.querySelector('.multi-selector-input');
                const suggestionContainer = container.querySelector('.suggestion-chips');
                
                const updateSuggestions = () => {
                    const val = input.value.trim().toLowerCase();
                    if (!val) {
                        suggestionContainer.innerHTML = '';
                        return;
                    }
                    const filtered = allSuggestions
                        .filter(s => s.toLowerCase().includes(val))
                        .slice(0, 3);
                    
                    suggestionContainer.innerHTML = '';
                    filtered.forEach(s => {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'suggestion-chip';
                        btn.setAttribute('data-value', s);
                        btn.textContent = s;
                        btn.addEventListener('click', () => addValueToQuery(paramName, s.toLowerCase()));
                        suggestionContainer.appendChild(btn);
                    });
                };

                input.addEventListener('input', updateSuggestions);

                input.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const val = input.value.trim().toLowerCase();
                        if (val) addValueToQuery(paramName, val);
                    }
                });

                container.querySelectorAll('.suggestion-chip').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const val = btn.getAttribute('data-value');
                        addValueToQuery(paramName, val.toLowerCase());
                    });
                });

                container.querySelectorAll('.remove-chip').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const chip = e.target.closest('.chip');
                        const val = chip.getAttribute('data-value');
                        removeValueFromQuery(paramName, val);
                    });
                });
            });
        }

        function wireJumpToSearch() {
            const btn = document.getElementById('jumpToSearchBtn');
            if (!btn) return;
            btn.addEventListener('click', () => {
                // Collect ShortDetails from gallery items
                const details = Array.from(document.querySelectorAll('.gallery-item'))
                    .map(el => el.getAttribute('data-short-details'))
                    .filter(d => d && d.length > 0);
                
                if (details.length === 0) {
                    alert('No photo details found to search for.');
                    return;
                }

                // Deduplicate and join into a single sentence
                const allSentences = details.flatMap(d => d.split('.').map(s => s.trim()).filter(s => s.length > 0));
                const uniqueSentences = [...new Set(allSentences)];
                const query = uniqueSentences.join('. ').trim();
                
                const url = new URL(window.location.origin + '/Home/Search');
                url.searchParams.set('query', query);
                
                // Carry over commerce rating if it was set
                const params = new URL(window.location.href).searchParams;
                const crs = params.getAll('commerceRatings');
                crs.forEach(cr => {
                    url.searchParams.append('commerceRatings', cr);
                });
                
                // Carry over folder filters
                params.getAll('foldersL1').forEach(f => url.searchParams.append('foldersL1', f));
                params.getAll('foldersL2').forEach(f => url.searchParams.append('foldersL2', f));
                
                window.location.href = url.toString();
            });
        }

        document.addEventListener('DOMContentLoaded', () => { 
            wirePageSizeButtons(); 
            wireSizeButtons(); 
            wireCommerceButtons();
            wireFilterButtons();
            wireJumpToSearch();
            preloadSelected();
            wireSelectionHandlers();
        });

        // Server now provides real slide sizes via data-pswp-width/height

        const lightbox = new PhotoSwipeLightbox({
            gallery: '#my-gallery',
            children: 'a',
            pswpModule: () => import('https://cdn.jsdelivr.net/npm/photoswipe@5.4.3/dist/photoswipe.esm.js')
        });

        lightbox.init();

        // --- Selection handlers (click/touch) ---
        const sessionId = '@(ViewBag.SessionId != null ? ViewBag.SessionId.ToString() : string.Empty)';
        function isValidGuid(g) { return /^[0-9a-fA-F-]{36}$/.test(g); }
        function markSelected(el, selected) {
            if (selected) el.classList.add('selected-thumb'); else el.classList.remove('selected-thumb');
        }
        function handleSelectClick(ev) {
            // Only enable selection on search results pages where sessionId is known
            if (!isValidGuid(sessionId)) return;
            const img = ev.currentTarget;
            const md5 = img.getAttribute('data-md5');
            if (!md5) return;
            ev.preventDefault();
            ev.stopPropagation();

            const selected = !img.classList.contains('selected-thumb');
            const url = selected ? '/selection/add' : '/selection/remove';
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: sessionId, md5: md5 })
            }).then(r => {
                if (r.ok) {
                    markSelected(img, selected);
                }
            }).catch(() => {});
        }

        async function preloadSelected() {
            if (!isValidGuid(sessionId)) return;
            try {
                const r = await fetch(`/selection/list?sessionId=${sessionId}`);
                if (!r.ok) return;
                const md5s = await r.json();
                if (!Array.isArray(md5s)) return;
                const set = new Set(md5s);
                document.querySelectorAll('#my-gallery img[data-md5]')
                    .forEach(img => {
                        const md5 = img.getAttribute('data-md5');
                        if (md5 && set.has(md5)) markSelected(img, true);
                    });
            } catch {}
        }

        function wireSelectionHandlers() {
            if (!isValidGuid(sessionId)) return;
            document.querySelectorAll('#my-gallery img[data-md5]')
                .forEach(img => {
                    img.style.cursor = 'pointer';
                    img.addEventListener('click', handleSelectClick, { passive: false });
                    img.addEventListener('touchend', handleSelectClick, { passive: false });
                });
        }
    </script>
}

