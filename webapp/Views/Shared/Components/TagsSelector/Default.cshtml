@{
    var available = ViewBag.AvailableTags as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var selected = ViewBag.SelectedTags as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
}

<div class="tag-input-container">
    <div id="selectedTagsChips" class="selected-chips">
        @foreach (var tag in selected)
        {
            <span class="chip" data-tag="@tag">
                @tag
                <button type="button" class="remove-tag-chip remove-chip" aria-label="Remove @tag">&times;</button>
            </span>
        }
    </div>
    <input type="text" id="tagInput" list="tagHints" class="tag-input" placeholder="Add tag..." autocomplete="off">
    <datalist id="tagHints">
        @foreach (var tag in available)
        {
            <option value="@tag"></option>
        }
    </datalist>
</div>
